    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">

            <!-- Soft circular badge behind the scene so it looks great on both Light (#FFFEE0) and Dark (#000000) splash backgrounds -->
            <path
                android:fillColor="#1A88D4DC"
                android:pathData="M54,54m-35,0a35,35 0,1 1,70 0a35,35 0,1 1,-70 0" />

            <!-- ================= BOTTOM ROW WITH TINY 1x1 GAP ================= -->
            <group
                android:name="bottom_row"
                android:pivotX="54"
                android:pivotY="75">
                <!-- Far-left Coral cell -->
                <path
                    android:fillColor="#E06D53"
                    android:pathData="M31,70h7.5c0.9,0 1.6,0.7 1.6,1.6v6.8c0,0.9 -0.7,1.6 -1.6,1.6H31c-0.9,0 -1.6,-0.7 -1.6,-1.6v-6.8c0,-0.9 0.7,-1.6 1.6,-1.6z" />
                <!-- Mid-left Amber cell -->
