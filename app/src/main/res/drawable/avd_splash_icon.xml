                    android:fillColor="#E89923"
                    android:pathData="M41.5,70h6.5c0.9,0 1.6,0.7 1.6,1.6v6.8c0,0.9 -0.7,1.6 -1.6,1.6h-6.5c-0.9,0 -1.6,-0.7 -1.6,-1.6v-6.8c0,-0.9 0.7,-1.6 1.6,-1.6z" />

                <!-- TINY 1x1 EMPTY CELL IN THE MIDDLE (The Impossible Hole) -->
                <path
                    android:fillColor="#CFCFC4"
                    android:strokeColor="#E06D53"
                    android:strokeWidth="1.0"
                    android:pathData="M51.8,71.2h4.4c0.7,0 1.3,0.6 1.3,1.3v4.4c0,0.7 -0.6,1.3 -1.3,1.3h-4.4c-0.7,0 -1.3,-0.6 -1.3,-1.3v-4.4c0,-0.7 0.6,-1.3 1.3,-1.3z" />

                <!-- Mid-right Lavender cell -->
                <path
                    android:fillColor="#8E6CEF"
                    android:pathData="M60,70h6.5c0.9,0 1.6,0.7 1.6,1.6v6.8c0,0.9 -0.7,1.6 -1.6,1.6H60c-0.9,0 -1.6,-0.7 -1.6,-1.6v-6.8c0,-0.9 0.7,-1.6 1.6,-1.6z" />
                <!-- Far-right Mint cell -->
                <path
                    android:fillColor="#43AA8B"
                    android:pathData="M69.5,70h7.5c0.9,0 1.6,0.7 1.6,1.6v6.8c0,0.9 -0.7,1.6 -1.6,1.6h-7.5c-0.9,0 -1.6,-0.7 -1.6,-1.6v-6.8c0,-0.9 0.7,-1.6 1.6,-1.6z" />
            </group>

            <!-- ================= GIANT PANICKING 3x3 TEAL BLOCK ================= -->
            <group
                android:name="block_3x3"
                android:pivotX="54"
                android:pivotY="66"
                android:rotation="-3.5">

                <!-- Soft drop shadow under the 3x3 block -->
                <path
                    android:fillColor="#22000000"
                    android:pathData="M36,24.5h36c2.5,0 4.5,2 4.5,4.5v32.5c0,2.5 -2,4.5 -4.5,4.5H59l-5,5.5l-5,-5.5H36c-2.5,0 -4.5,-2 -4.5,-4.5V29c0,-2.5 2,-4.5 4.5,-4.5z" />

                <!-- Outer dark-teal frame of the 3x3 block -->
                <path
                    android:fillColor="#1A6582"
                    android:pathData="M35.5,22.5h37c2.5,0 4.5,2 4.5,4.5v32.5c0,2.5 -2,4.5 -4.5,4.5H58.8L54,69.5L49.2,64H35.5c-2.5,0 -4.5,-2 -4.5,-4.5V27c0,-2.5 2,-4.5 4.5,-4.5z" />

                <!-- Row 1 -->
                <path
                    android:fillColor="#2D9CDB"
                    android:pathData="M35,25h10c0.9,0 1.6,0.7 1.6,1.6v7.3c0,0.9 -0.7,1.6 -1.6,1.6H35c-0.9,0 -1.6,-0.7 -1.6,-1.6v-7.3c0,-0.9 0.7,-1.6 1.6,-1.6z" />
                <path
                    android:fillColor="#2D9CDB"
                    android:pathData="M49,25h10c0.9,0 1.6,0.7 1.6,1.6v7.3c0,0.9 -0.7,1.6 -1.6,1.6H49c-0.9,0 -1.6,-0.7 -1.6,-1.6v-7.3c0,-0.9 0.7,-1.6 1.6,-1.6z" />
                <path
                    android:fillColor="#2D9CDB"
                    android:pathData="M63,25h10c0.9,0 1.6,0.7 1.6,1.6v7.3c0,0.9 -0.7,1.6 -1.6,1.6H63c-0.9,0 -1.6,-0.7 -1.6,-1.6v-7.3c0,-0.9 0.7,-1.6 1.6,-1.6z" />

                <!-- Row 2 -->
                <path
                    android:fillColor="#2D9CDB"
                    android:pathData="M35,38h10c0.9,0 1.6,0.7 1.6,1.6v7.3c0,0.9 -0.7,1.6 -1.6,1.6H35c-0.9,0 -1.6,-0.7 -1.6,-1.6v-7.3c0,-0.9 0.7,-1.6 1.6,-1.6z" />
                <path
                    android:fillColor="#2D9CDB"
                    android:pathData="M49,38h10c0.9,0 1.6,0.7 1.6,1.6v7.3c0,0.9 -0.7,1.6 -1.6,1.6H49c-0.9,0 -1.6,-0.7 -1.6,-1.6v-7.3c0,-0.9 0.7,-1.6 1.6,-1.6z" />
                <path
                    android:fillColor="#2D9CDB"
                    android:pathData="M63,38h10c0.9,0 1.6,0.7 1.6,1.6v7.3c0,0.9 -0.7,1.6 -1.6,1.6H63c-0.9,0 -1.6,-0.7 -1.6,-1.6v-7.3c0,-0.9 0.7,-1.6 1.6,-1.6z" />

                <!-- Row 3 -->
                <path
                    android:fillColor="#2D9CDB"
                    android:pathData="M35,51h10c0.9,0 1.6,0.7 1.6,1.6v7.3c0,0.9 -0.7,1.6 -1.6,1.6H35c-0.9,0 -1.6,-0.7 -1.6,-1.6v-7.3c0,-0.9 0.7,-1.6 1.6,-1.6z" />
                <path
                    android:fillColor="#2D9CDB"
                    android:pathData="M49,51h10c0.9,0 1.6,0.7 1.6,1.6v8.5L54,67l-6.6,-5.9v-8.5c0,-0.9 0.7,-1.6 1.6,-1.6z" />
                <path
                    android:fillColor="#2D9CDB"
                    android:pathData="M63,51h10c0.9,0 1.6,0.7 1.6,1.6v7.3c0,0.9 -0.7,1.6 -1.6,1.6H63c-0.9,0 -1.6,-0.7 -1.6,-1.6v-7.3c0,-0.9 0.7,-1.6 1.6,-1.6z" />

                <!-- Top glossy highlights -->
                <path
                    android:fillColor="#88D4DC"
                    android:pathData="M35.5,26.2h9c0.5,0 0.8,0.4 0.8,0.8v1H34.7v-1c0,-0.4 0.3,-0.8 0.8,-0.8z" />
                <path
                    android:fillColor="#88D4DC"
                    android:pathData="M49.5,26.2h9c0.5,0 0.8,0.4 0.8,0.8v1H48.7v-1c0,-0.4 0.3,-0.8 0.8,-0.8z" />
                <path
                    android:fillColor="#88D4DC"
                    android:pathData="M63.5,26.2h9c0.5,0 0.8,0.4 0.8,0.8v1H62.7v-1c0,-0.4 0.3,-0.8 0.8,-0.8z" />

                <!-- Bulging eye whites -->
                <path
                    android:fillColor="#FFFFFF"
                    android:strokeColor="#12475B"
                    android:strokeWidth="1.6"
                    android:pathData="M43.5,39.5m-7,0a7,7 0,1 1,14 0a7,7 0,1 1,-14 0" />
                <path
                    android:fillColor="#FFFFFF"
                    android:strokeColor="#12475B"
                    android:strokeWidth="1.6"
                    android:pathData="M64.5,40m-5.6,0a5.6,5.6 0,1 1,11.2 0a5.6,5.6 0,1 1,-11.2 0" />

                <!-- Animated trembling pupils -->
                <group
                    android:name="pupils"
                    android:pivotX="54"
                    android:pivotY="42.8">
                    <path
                        android:fillColor="#111111"
                        android:pathData="M45,42.8m-2.2,0a2.2,2.2 0,1 1,4.4 0a2.2,2.2 0,1 1,-4.4 0" />
                    <path
                        android:fillColor="#111111"
                        android:pathData="M63,42.8m-1.7,0a1.7,1.7 0,1 1,3.4 0a1.7,1.7 0,1 1,-3.4 0" />
                    <path
                        android:fillColor="#FFFFFF"
                        android:pathData="M44,41.6m-0.8,0a0.8,0.8 0,1 1,1.6 0a0.8,0.8 0,1 1,-1.6 0" />
                    <path
                        android:fillColor="#FFFFFF"
                        android:pathData="M62.3,41.8m-0.65,0a0.65,0.65 0,1 1,1.3 0a0.65,0.65 0,1 1,-1.3 0" />
                </group>

                <!-- Worried eyebrows -->
                <path
                    android:fillColor="#00000000"
                    android:strokeColor="#12475B"
                    android:strokeWidth="2.2"
                    android:strokeLineCap="round"
                    android:pathData="M36,33.5 Q41.5,29 48.5,31.5" />
                <path
                    android:fillColor="#00000000"
                    android:strokeColor="#12475B"
                    android:strokeWidth="2.2"
                    android:strokeLineCap="round"
                    android:pathData="M59.5,31.5 Q66,29.5 71,34" />

                <!-- Grimacing mouth with clenched teeth -->
                <path
                    android:fillColor="#FFFFFF"
                    android:strokeColor="#12475B"
                    android:strokeWidth="1.7"
                    android:pathData="M40.5,51.5 C44,49 49,52 54,49.8 C59,52 64,49 67.5,51.5 C69,52.8 68.5,57.5 66,58.5 C60,60 48,60 42,58.5 C39.5,57.5 39,52.8 40.5,51.5 Z" />
                <path
                    android:fillColor="#00000000"
                    android:strokeColor="#12475B"
                    android:strokeWidth="1.2"
                    android:pathData="M39.8,54.8 H68.2 M47,50.8 V59 M54,50 V59.4 M61,50.8 V59" />

                <!-- Blushing cheeks -->
                <path
                    android:fillColor="#F4978E"
                    android:fillAlpha="0.9"
                    android:pathData="M36,48a2.8,1.8 0,1 0,5.6 0a2.8,1.8 0,1 0,-5.6 0" />
                <path
                    android:fillColor="#F4978E"
                    android:fillAlpha="0.9"
                    android:pathData="M66.5,48a2.8,1.8 0,1 0,5.6 0a2.8,1.8 0,1 0,-5.6 0" />
            </group>

            <!-- ================= ANIMATED SWEAT DROPS & STRESS LINES ================= -->
            <group
                android:name="sweat_drops"
                android:pivotX="54"
                android:pivotY="36">
                <path
                    android:fillColor="#88D4DC"
                    android:strokeColor="#1A6582"
                    android:strokeWidth="1.0"
                    android:pathData="M26.5,31 C26.5,31 23,35 24.2,37.5 C25.2,39.5 28.2,39.5 29,37.5 C30,35 26.5,31 26.5,31 Z" />
                <path
                    android:fillColor="#88D4DC"
                    android:strokeColor="#1A6582"
                    android:strokeWidth="1.0"
                    android:pathData="M81.5,27 C81.5,27 78,31 79.2,33.5 C80.2,35.5 83.2,35.5 84,33.5 C85,31 81.5,27 81.5,27 Z" />
                <path
                    android:fillColor="#88D4DC"
                    android:strokeColor="#1A6582"
                    android:strokeWidth="0.9"
                    android:pathData="M82.5,43 C82.5,43 80,46 80.9,47.8 C81.7,49.2 83.8,49.2 84.4,47.8 C85.2,46 82.5,43 82.5,43 Z" />
                <path
                    android:fillColor="#00000000"
                    android:strokeColor="#E06D53"
                    android:strokeWidth="1.6"
                    android:strokeLineCap="round"
                    android:pathData="M46.5,66.5 L49.5,69.5 M61.5,66.5 L58.5,69.5" />
            </group>
        </vector>
    </aapt:attr>

    <!-- 3x3 Block squash-and-stretch + nervous wiggle trying to fit into the 1x1 gap -->
    <target android:name="block_3x3">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="450"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="translateY"
                    android:valueFrom="-8"
                    android:valueTo="0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="450"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleX"
                    android:valueFrom="0.88"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="450"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleY"
                    android:valueFrom="1.12"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="160"
                    android:propertyName="rotation"
                    android:repeatCount="3"
                    android:repeatMode="reverse"
                    android:startOffset="220"
                    android:valueFrom="-6.5"
                    android:valueTo="2.5"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

    <!-- Pupils darting side-to-side in panic -->
    <target android:name="pupils">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="130"
                android:propertyName="translateX"
                android:repeatCount="4"
                android:repeatMode="reverse"
                android:startOffset="180"
                android:valueFrom="-1.4"
                android:valueTo="1.4"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <!-- Sweat drops popping out -->
    <target android:name="sweat_drops">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="500"
                    android:interpolator="@android:interpolator/decelerate_cubic"
                    android:propertyName="translateY"
                    android:startOffset="180"
                    android:valueFrom="-3"
                    android:valueTo="1.5"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="400"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleX"
                    android:startOffset="150"
                    android:valueFrom="0.5"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="400"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleY"
                    android:startOffset="150"
                    android:valueFrom="0.5"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
